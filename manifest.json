{
  "id": "/stext-editor",
  "name": "S-Text Editor",
  "short_name": "S-Text",
  "description": "A fast, offline-capable text and code editor with Google Workspace styling.",
  "start_url": "./index.html",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "categories": ["productivity", "utilities", "business"],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/plain": [".txt", ".md", ".csv", ".json", ".xml", ".html", ".css", ".js", ".py", ".c", ".cpp", ".java", ".cs"]
      }
    }
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}